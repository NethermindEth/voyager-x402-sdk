{
  "name": "voyager-x402-sdk",
  "version": "0.1.0",
  "description": "Zero-configuration SDK for Voyager x402 payment-protected APIs - supports both EVM and Starknet",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/voyager.d.ts",
      "import": "./dist/types/voyager.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "bun test tests/**/*.test.ts",
    "test:unit": "bun test tests/unit/**/*.test.ts",
    "test:integration": "bun test tests/integration/**/*.test.ts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "bun run format:check && bun run type-check && bun run lint",
    "prepublishOnly": "bun run clean && bun run build && bun run test",
    "client:evm": "bun run examples/evm-client.ts",
    "client:starknet": "bun run examples/starknet-client.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/voyager-x402-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/voyager-x402-sdk/issues"
  },
  "homepage": "https://github.com/your-org/voyager-x402-sdk#readme",
  "keywords": [
    "voyager",
    "x402",
    "micropayments",
    "starknet",
    "evm",
    "blockchain",
    "sdk",
    "client",
    "payment",
    "api"
  ],
  "author": "Voyager x402 Team",
  "license": "Apache-2.0",
  "dependencies": {
    "x402-fetch": "^0.5.1",
    "x402-starknet": "^0.3.1",
    "viem": "^2.38.6",
    "starknet": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "dotenv": "^16.4.5",
    "eslint": "^9.18.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.5.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.46.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
